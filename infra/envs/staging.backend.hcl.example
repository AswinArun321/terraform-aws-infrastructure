# Backend configuration for Staging environment
# Usage:
# Copy this file to staging.backend.hcl and substitute <state-bucket-name>
# terraform init -backend-config=envs/staging.backend.hcl -reconfigure

bucket       = "<state-bucket-name>"
key          = "staging/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
